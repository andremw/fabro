+/// Map image MIME type to file extension.
+fn extension_for_mime(mime: &str) -> &'static str {
+    match mime {
+        "image/png" => "png",
+        "image/jpeg" => "jpg",
+        "image/gif" => "gif",
+        "image/webp" => "webp",
+        "image/heic" => "heic",
+        _ => "bin",
+    }
+}
+
+/// Store answer images in the run artifact directory.
+/// Returns a vector of absolute paths to the stored images.
+async fn store_answer_images(
+    images: &[fabro_interview::ImageAttachment],
+    stage_id: &str,
+    run_dir: &Path,
+) -> Result<Vec<PathBuf>, Error> {
+    use tokio::fs;
+
+    let mut paths = Vec::new();
+    for (index, image) in images.iter().enumerate() {
+        let ext = extension_for_mime(&image.media_type);
+        let filename = format!("human_{stage_id}_image_{index}.{ext}");
+        let path = run_dir.join(&filename);
+        fs::write(&path, &image.data).await.map_err(|err| {
+            Error::handler(format!(
+                "failed to write image {filename} to {}: {err}",
+                run_dir.display()
+            ))
+        })?;
+        paths.push(path);
+    }
+    Ok(paths)
+}
