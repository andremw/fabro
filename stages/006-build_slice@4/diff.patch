+
+        let mut graph = Graph::new("test");
+        let mut gate = Node::new("gate");
+        gate.attrs
+            .insert("label".to_string(), AttrValue::String("Choose".to_string()));
+        graph.nodes.insert("gate".to_string(), gate);
